# ローカル開発で使う Firebase の設定値の見本
# このファイルを .env にコピーして、値を書く。.env はコミットしない(.gitignore 済み)
# 値は、Firebase のコンソールの「プロジェクトの設定」→「マイアプリ」にある

# Firebase のプロジェクト ID。api(トークンの検証)と web(ログイン)の両方で使う
FIREBASE_PROJECT_ID=

# web(Vue)が使う、Firebase のウェブアプリの設定値
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
